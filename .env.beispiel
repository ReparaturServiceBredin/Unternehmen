# Einstellungen für den Server-Betrieb. Kopieren nach .env und anpassen.
# Anleitung: docs/BETRIEB_SERVER.md

# desktop (Standard, Windows mit Fenster) oder server (Linux/Docker, nur Browser-Zugriff)
RSB_MODUS=server

# Datenordner (Server/Docker z. B. /daten)
RSB_DATEN=/daten

# Netzwerkadresse, auf der das Programm lauscht (Server: 0.0.0.0)
RSB_HOST=0.0.0.0

# Port (Standard 5000)
RSB_PORT=5000

# gleichzeitige Anfragen (Standard 8)
RSB_THREADS=8

# 1 = läuft hinter einem Reverse-Proxy (Caddy/nginx) – echte Client-Adresse übernehmen
RSB_HINTER_PROXY=1

# 1 = Zugriff nur per HTTPS (Cookies mit Secure-Flag)
RSB_SICHERE_COOKIES=1

# nur beim ersten Start: Passwort für die Anmeldung setzen (danach entfernen)
RSB_ERSTES_PASSWORT=

# INFO (Standard), DEBUG, WARNING
RSB_LOG_STUFE=INFO
